APPLICATION_PORT=3333

# PostgreSQL connection string (Neon/Supabase/etc)
DATABASE_URL=

# Better Auth
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública onde este servidor roda (ex: http://localhost:3333)
BETTER_AUTH_URL=

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (discord.com/developers/applications)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email do dono do sistema — só essa conta pode aprovar/bloquear usuários
OWNER_EMAIL=
