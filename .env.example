APPLICATION_PORT=3333

# PostgreSQL connection string (Neon/Supabase/etc)
DATABASE_URL=

# Better Auth
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# ORIGEM PÚBLICA QUE O NAVEGADOR VÊ — em produção o domínio do front (que reescreve
# /api para este servidor), NÃO o host interno. Precisa ser a mesma de CLIENT_URL,
# senão o cookie de state do OAuth é gravado numa origem e esperado na outra
# ("State not persisted correctly"). Ex: https://zammad-comhub.vercel.app
BETTER_AUTH_URL=

# URL do frontend — única origem aceita pelo CORS e usada como trustedOrigin.
# Em produção deve ser IGUAL a BETTER_AUTH_URL (mesma origem).
CLIENT_URL=http://localhost:3001

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (discord.com/developers/applications)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email do dono do sistema — só essa conta pode aprovar/bloquear usuários
OWNER_EMAIL=

# Integração com Zammad
ZAMMAD_BASE_URL=https://zammad.innovtechsolutions.com.br
# Chave pra cifrar o token do Zammad em repouso. Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Token de serviço (não é de um usuário específico) usado pelo servidor pra listar
# todos os usuários do Zammad e validar cadastros novos. Gere em /#profile/token_access
# com uma conta que tenha permissão de listar todos os usuários.
ZAMMAD_TOKEN=

# Redis — fila de jobs (BullMQ) do worker de sincronização
REDIS_URL=redis://localhost:6379
